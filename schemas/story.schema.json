{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.schema.json",
  "type": "object",
  "required": ["schema_version", "meta", "characters", "outline", "script"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.3"},
    "meta": {"type": "object"},
    "characters": {"type": "array", "minItems": 1, "maxItems": 12},
    "outline": {"type": "object"},
    "script": {"type": "array", "minItems": 8}
  }
}
